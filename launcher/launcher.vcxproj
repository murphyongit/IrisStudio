  <!-- IrisStudio.exe, the launcher users download: it embeds T5iris.dll of the same
       configuration, so the t5 project builds first. The C runtime is linked in, so it runs without the Visual C++
       redistributable. -->
  <PropertyGroup>
    <TargetName>IrisStudio</TargetName>
    <OutDir>$(SolutionDir)launcher\bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)launcher\bin\$(Platform)\$(Configuration)\intermediate\</IntDir>
  </PropertyGroup>
  <!-- a beta build: the key screen, and the beta T5iris.dll embedded, in folders of its
       own -->
  <PropertyGroup Condition="'$(IrisBeta)'=='true' or '$(IrisBeta)'=='test'">
    <OutDir>$(SolutionDir)launcher\bin\$(Platform)\$(Configuration)Beta\</OutDir>
    <IntDir>$(SolutionDir)launcher\bin\$(Platform)\$(Configuration)Beta\intermediate\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <!-- src first, so the core sources get this StdInclude.hpp instead of the game's -->
      <AdditionalIncludeDirectories>$(ProjectDir)src;$(SolutionDir)core\src;$(SolutionDir)core\third-party\imgui;$(SolutionDir)core\third-party\IconFontCppHeaders;$(SolutionDir)core\third-party\json\single_include;$(SolutionDir)tools\injector\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;_WINDOWS;NOMINMAX;WIN32_LEAN_AND_MEAN;IMGUI_DEFINE_MATH_OPERATORS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <LargeAddressAware>true</LargeAddressAware>
      <AdditionalDependencies>d3d9.lib;dwmapi.lib;windowscodecs.lib;winhttp.lib;bcrypt.lib;shlwapi.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)res;$(SolutionDir)core\resources;$(SolutionDir)t5\bin\$(Platform)\$(Configuration);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <ClCompile>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(IrisBeta)'=='true' or '$(IrisBeta)'=='test'">
    <ClCompile>
      <PreprocessorDefinitions>IRIS_BETA;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(SolutionDir)t5\bin\$(Platform)\$(Configuration)Beta;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(IrisBeta)'=='test'">
    <ClCompile>
